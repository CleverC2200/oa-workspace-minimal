# Copy to .env and fill values locally. Never commit real credentials or internal hosts.
OA_BASE_URL=https://oa.example.com
OA_APP_ID=
OA_APP_SECRET=
OA_UID=
OA_TRIP_BASE_URL=https://travel.example.com
OA_EXTRA_DOWNLOAD_HOSTS=travel.example.com

# Optional read-only Oracle connection.
OA_DB_HOST=
OA_DB_PORT=1521
OA_DB_SERVICE=
OA_DB_USER=
OA_DB_PASSWORD=
OA_DB_KEYCHAIN_SERVICE=
ORACLE_CLIENT_LIB_DIR=

# Optional local runtime tuning.
OA_ALLOW_BROWSER_DOWNLOAD=false
OA_KEEP_ATTACHMENTS=false
OA_KEEP_DOWNLOAD_SOURCE=false
OA_ATTACHMENT_DOWNLOAD_CONCURRENCY=4
OA_ATTACHMENT_GLOBAL_DOWNLOAD_CAPACITY=6
OA_TRAVEL_BROWSER_CAPACITY=1
OA_ATTACHMENT_ARCHIVE_MAX_FILES=100
OA_ATTACHMENT_ARCHIVE_MAX_FILE_BYTES=52428800
OA_ATTACHMENT_ARCHIVE_MAX_TOTAL_BYTES=209715200

# Optional attachment model integration. Keep credentials local.
OA_ATTACHMENT_AI_COMMAND=
OA_ATTACHMENT_API_BASE_URL=
OA_ATTACHMENT_API_KEY=
OA_ATTACHMENT_API_MODEL=
OA_ATTACHMENT_CODEX_MODEL=
OA_ATTACHMENT_CODEX_FALLBACK_MODEL=
OA_ATTACHMENT_CODEX_TIMEOUT_SEC=120
OA_ATTACHMENT_CODEX_CONCURRENCY=2
OA_ATTACHMENT_CODEX_BATCH_SIZE=4
